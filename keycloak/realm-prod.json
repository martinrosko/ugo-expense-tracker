{
  "realm": "ugo",
  "displayName": "Ugo Finance",
  "enabled": true,
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "ugo-frontend",
      "name": "Ugo Frontend SPA",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${APP_URL}/*"
      ],
      "webOrigins": [
        "${APP_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "ugo-mcp",
      "name": "Ugo MCP clients",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:*",
        "http://localhost:*",
        "https://vscode.dev/redirect"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "ugo-mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ugo-mcp",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      { "name": "app-user", "description": "Regular application user" },
      { "name": "app-admin", "description": "Application administrator" }
    ]
  },
  "defaultRoles": ["app-user"]
}
