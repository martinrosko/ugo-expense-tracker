{
  "name": "ugo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w packages/frontend",
    "build": "npm run build -w packages/frontend",
    "backend:dev": "npm run dev -w packages/backend",
    "backend:dev:debug": "npm run dev:debug -w packages/backend",
    "backend:build": "npm run build -w packages/backend",
    "docker:up": "docker compose up -d",
    "docker:up:dev": "docker compose up -d postgres keycloak",
    "docker:down": "docker compose down",
    "start:all": "npm run docker:up:dev && concurrently -k -n backend,frontend -c blue,green \"npm:backend:dev\" \"npm:dev\"",
    "docker:build": "docker compose build"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
