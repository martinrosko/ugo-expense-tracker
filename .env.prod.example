# Production settings for docker-compose.prod.yml. Copy to .env.prod (gitignored) and fill in.
# Use letters and digits only in passwords: POSTGRES_PASSWORD goes into a connection URL.

# Public hostnames; each needs a DNS A record to this machine's public IP and ports 80/443 forwarded to it
APP_HOST=app.tozzi.sk
AUTH_HOST=auth.tozzi.sk
MCP_HOST=mcp.tozzi.sk

# Let's Encrypt notices go here. ACME_CA defaults to the production CA when left empty;
# the staging CA below avoids rate limits while DNS and port forwarding are being checked
ACME_EMAIL=you@example.com
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
