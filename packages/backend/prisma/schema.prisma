generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User (mirrored from Keycloak on first login) ─────────────────────────────

model User {
  id             String        @id            // Keycloak subject UUID
  email          String        @unique
  name           String
  timezone       String?       /// IANA name; null until first set. Defines "today" for plan status automation
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  businessUnitId String?
  accounts       Account[]
  plans          Plan[]
  tags           Tag[]
  coOwnedAccounts AccountCoOwner[]
  planMemberships PlanMember[]
  createdTransactions Transaction[] @relation("TxCreatedBy")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model BusinessUnit {
  id        String   @id @default(uuid())
  name      String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Accounts ─────────────────────────────────────────────────────────────────

model Account {
  id             String      @id @default(uuid())
  name           String
  type           AccountType
  initialBalance Decimal     @default(0) @db.Decimal(18, 4)
  isDefault      Boolean     @default(false)
  /// Code of a known bank (see routes/accounts.ts), only for BANK accounts
  bank           String?
  stateCode      Int         @default(0) /// 0 = Active, 1 = Inactive
  statusCode     Int         @default(0)
  owner          User        @relation(fields: [ownerId], references: [id])
  ownerId        String

  bankTickets       BankTicket[]
  fromTransactions  Transaction[] @relation("TxFromAccount")
  toTransactions    Transaction[] @relation("TxToAccount")
  defaultForBudgets Budget[]      @relation("BudgetDefaultAccount")
  defaultForPlans   Plan[]        @relation("PlanDefaultAccount")
  tags              TagObject[]
  coOwners          AccountCoOwner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Extra users with the owner's rights on the account's transactions and bank tickets; never on payment partners.
model AccountCoOwner {
  id        String   @id @default(uuid())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([accountId, userId])
  @@index([userId])
}

enum AccountType {
  CASH
  BANK
  INVESTMENT
  PAYMENT_PARTNER
}

// ─── Plans & Budgets ──────────────────────────────────────────────────────────

model Plan {
  id                String           @id @default(uuid())
  name              String?
  startDate         DateTime?        @db.Date
  endDate           DateTime?        @db.Date
  intervalType      PlanIntervalType
  recurrenceConfig  String?          /// JSON string from rw_recurrenceconfig
  isTemplate        Boolean          @default(false)
  stateCode         Int              @default(0) /// 0 = Active, 1 = Inactive
  statusCode        Int              @default(0) /// 0=Draft 1=Active 2=Scheduled 3=Completed 4=Cancelled
  template          Plan?            @relation("PlanFromTemplate", fields: [templateId], references: [id])
  templateId        String?
  instances         Plan[]           @relation("PlanFromTemplate")
  defaultAccount    Account?         @relation("PlanDefaultAccount", fields: [defaultAccountId], references: [id])
  defaultAccountId  String?
  owner             User             @relation(fields: [ownerId], references: [id])
  ownerId           String
  budgets           Budget[]
  transactions      Transaction[]
  tags              TagObject[]
  members           PlanMember[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([statusCode, startDate, endDate])
}

/// Membership of a template also applies to the plans generated from it.
model PlanMember {
  id        String   @id @default(uuid())
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      PlanRole
  createdAt DateTime @default(now())

  @@unique([planId, userId])
  @@index([userId])
}

enum PlanRole {
  VIEWER
  CONTRIBUTOR
}

enum PlanIntervalType {
  ONE_TIME
  WEEKLY
  MONTHLY
  YEARLY
}

model Budget {
  id               String   @id @default(uuid())
  name             String?
  amount           Decimal? @db.Decimal(18, 4)
  stateCode        Int      @default(0)
  statusCode       Int      @default(0)
  plan             Plan     @relation(fields: [planId], references: [id])
  planId           String
  defaultAccount   Account? @relation("BudgetDefaultAccount", fields: [defaultAccountId], references: [id])
  defaultAccountId String?
  template         Budget?  @relation("BudgetFromTemplate", fields: [templateId], references: [id])
  templateId       String?
  instances        Budget[] @relation("BudgetFromTemplate")
  transactions     Transaction[]
  tags             TagObject[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Bank Tickets (raw bank statement rows) ───────────────────────────────────

model BankTicket {
  id                   String   @id @default(uuid())
  name                 String?
  amount               Decimal  @db.Decimal(18, 4)
  executedOn           DateTime
  partnerName          String?
  partnerAccountNumber String?
  reference            String?
  variableSymbol       String?
  constantSymbol       String?
  specificSymbol       String?
  stateCode            Int      @default(0)
  statusCode           Int      @default(0)
  /// Bank-assigned transaction ID — used for deduplication
  ticketId             String?
  account              Account  @relation(fields: [accountId], references: [id])
  accountId            String
  transaction          Transaction? @relation("TxBankTicket")
  /// Second ticket of a movement between two own accounts: processed without being the transaction's own ticket
  pairedTransaction    Transaction? @relation("TxPairedTickets", fields: [pairedTransactionId], references: [id], onDelete: SetNull)
  pairedTransactionId  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  /// The bank's document number repeats across dates, so the date is part of the identity
  @@unique([accountId, ticketId, executedOn])
  @@index([pairedTransactionId])
}

// ─── Transactions ─────────────────────────────────────────────────────────────

model Transaction {
  id            String          @id @default(uuid())
  name          String?
  amount        Decimal?        @db.Decimal(18, 4)
  plannedAmount Decimal?        @db.Decimal(18, 4)
  plannedOn     DateTime?
  executedOn    DateTime?
  dueDateConfig String?
  type          TransactionType
  stateCode     Int             @default(0)
  statusCode    Int             @default(0)
  bankTicket    BankTicket?     @relation("TxBankTicket", fields: [bankTicketId], references: [id])
  bankTicketId  String?         @unique
  pairedTickets BankTicket[]    @relation("TxPairedTickets")
  budget        Budget?         @relation(fields: [budgetId], references: [id])
  budgetId      String?
  plan          Plan?           @relation(fields: [planId], references: [id])
  planId        String?
  fromAccount   Account?        @relation("TxFromAccount", fields: [fromAccountId], references: [id])
  fromAccountId String?
  toAccount     Account?        @relation("TxToAccount", fields: [toAccountId], references: [id])
  toAccountId   String?
  template      Transaction?    @relation("TxFromTemplate", fields: [templateId], references: [id])
  templateId    String?
  instances     Transaction[]   @relation("TxFromTemplate")
  tags          TagObject[]
  /// Null for rows generated from a template; those count as the plan owner's
  createdBy     User?           @relation("TxCreatedBy", fields: [createdById], references: [id])
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([createdById])
}

enum TransactionType {
  TRANSACTION
  BALANCE
}

// ─── Tags ─────────────────────────────────────────────────────────────────────

model Tag {
  id           String           @id @default(uuid())
  name         String
  color        String?
  stateCode    Int              @default(0)
  statusCode   Int              @default(0)
  owner        User             @relation(fields: [ownerId], references: [id])
  ownerId      String
  objects      TagObject[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

/// Assigns a tag to exactly one object: a transaction, plan, budget or account (enforced by a CHECK constraint).
model TagObject {
  id            String       @id @default(uuid())
  tag           Tag          @relation(fields: [tagId], references: [id])
  tagId         String
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  transactionId String?
  plan          Plan?        @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId        String?
  budget        Budget?      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId      String?
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String?
  amount        Decimal?     @db.Decimal(18, 4)
  createdAt     DateTime     @default(now())

  @@unique([transactionId, tagId])
  @@unique([planId, tagId])
  @@unique([budgetId, tagId])
  @@unique([accountId, tagId])
}
