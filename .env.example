# Read by docker compose; defaults suit local development
# Public Keycloak realm URL; must equal the `iss` claim of issued tokens
KEYCLOAK_ISSUER=http://localhost:8080/realms/ugo
# Public URL of the MCP server as clients reach it (HTTPS in production)
MCP_PUBLIC_URL=http://localhost:3001
# Optional: require this aud claim on MCP tokens
MCP_AUDIENCE=
# Optional: comma-separated browser origins allowed to call /mcp
MCP_ALLOWED_ORIGINS=
